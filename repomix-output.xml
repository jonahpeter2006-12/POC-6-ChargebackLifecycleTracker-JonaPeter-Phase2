  height: 28px;
  border-radius: 50%;
  color: #e7d9ff;
  background: #3d3056;
  font-size: 10px;
  font-weight: 700;
}

.metadata-label,
.metadata-chevron {
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 9px;
  letter-spacing: 0.08em;
}

.metadata-chevron {
  color: var(--accent);
}

/* Main layout */

.page-content {
  position: relative;
  z-index: 1;
  width: min(1440px, 92%);
  margin: 0 auto;
}

.hero-section {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;
  padding: clamp(65px, 7vw, 105px) 0 55px;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0;
  color: var(--accent);
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.16em;
}

.eyebrow-line {
  width: 24px;
  height: 1px;
  background: var(--accent);
}

.hero-section h1 {
  margin: 23px 0 0;
  font-size: clamp(48px, 6vw, 86px);
  font-weight: 600;
  line-height: 0.99;
  letter-spacing: -0.075em;
}

.hero-section h1 span {
  color: var(--accent);
}

.hero-description {
  max-width: 600px;
  margin: 25px 0 0;
  color: #9692a5;
  font-size: 14px;
  line-height: 1.9;
}

.hero-index {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 7px;
  padding-bottom: 7px;
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 9px;
  letter-spacing: 0.1em;
}

.hero-index strong {
  color: rgba(192, 170, 230, 0.72);
  font-size: 57px;
  font-weight: 400;
  letter-spacing: -0.08em;
}

/* Summary cards */

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.metric-card {
  position: relative;
  min-width: 0;
  padding: 25px;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 15px;
  background: linear-gradient(
    145deg,
    rgba(25, 23, 37, 0.92),
    rgba(15, 14, 23, 0.9)
  );
  transition: transform 180ms ease, border-color 180ms ease;
}

.metric-card:hover {
  transform: translateY(-3px);
  border-color: rgba(183, 154, 232, 0.34);
}

.metric-primary {
  border-color: rgba(183, 154, 232, 0.35);
  background: linear-gradient(
    145deg,
    rgba(82, 61, 112, 0.36),
    rgba(22, 19, 32, 0.94)
  );
}

.metric-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  color: #aaa5ba;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 9px;
  letter-spacing: 0.1em;
}

.metric-icon {
  color: var(--accent);
  font-size: 18px;
}

.loss-icon,
.loss-value {
  color: var(--danger) !important;
}

.pending-icon {
  color: var(--warning);
}

.metric-card > strong {
  display: block;
  margin-top: 23px;
  font-size: clamp(24px, 2.5vw, 34px);
  font-weight: 550;
  letter-spacing: -0.055em;
  overflow-wrap: anywhere;
}

.metric-card > p {
  margin: 9px 0 0;
  color: #777487;
  font-size: 11px;
}

/* Dashboard sections */

.section-block {
  margin-top: 67px;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 25px;
}

.section-heading h2,
.outcomes-strip h2 {
  margin: 10px 0 0;
  font-size: 24px;
  font-weight: 550;
  letter-spacing: -0.045em;
}

.section-description {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.7;
}

.section-count {
  padding: 8px 11px;
  border: 1px solid var(--border);
  border-radius: 7px;
  color: #aaa4bb;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 9px;
  letter-spacing: 0.1em;
  white-space: nowrap;
}

/* Lifecycle */

.lifecycle-track {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 16px;
  padding: 26px;
  border: 1px solid var(--border);
  border-radius: 15px;
  background: rgba(18, 17, 27, 0.77);
}

.stage-item {
  min-width: 0;
}

.stage-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.stage-number {
  color: #706a80;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 10px;
}

.stage-count {
  color: var(--accent-bright);
  font-size: 17px;
  font-weight: 600;
}

.stage-track,
.distribution-track {
  height: 4px;
  overflow: hidden;
  border-radius: 10px;
  background: #292536;
}

.stage-fill,
.distribution-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #755b9e, #c2a5f0);
  box-shadow: 0 0 12px rgba(183, 154, 232, 0.28);
  transition: width 350ms ease;
}

.stage-item > p {
  min-height: 30px;
  margin: 12px 0 0;
  color: #b8b3c5;
  font-size: 10px;
  line-height: 1.5;
}

/* Dispute distribution */

.distribution-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 13px;
}

.distribution-card {
  padding: 21px;
  border: 1px solid var(--border);
  border-radius: 13px;
  background: rgba(19, 18, 29, 0.8);
}

.distribution-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--accent-bright);
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 11px;
}

.distribution-index {
  color: #716b80;
  font-size: 9px;
}

.distribution-card h3 {
  min-height: 38px;
  margin: 17px 0;
  color: #e0dce9;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.5;
}

.distribution-card > p {
  margin: 12px 0 0;
  color: #777487;
  font-size: 10px;
}

.distribution-track {
  height: 5px;
}

.distribution-fill {
  background: linear-gradient(90deg, #70568f, #c1a1ef);
}

.empty-message,
.empty-table {
  color: var(--muted);
  font-size: 12px;
}

/* Filters and table */

.cases-section {
  margin-bottom: 65px;
}

.download-button,
.reset-button {
  border: 1px solid rgba(183, 154, 232, 0.3);
  border-radius: 8px;
  color: var(--accent-bright);
  background: rgba(183, 154, 232, 0.07);
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 9px;
  letter-spacing: 0.09em;
  transition: background 180ms ease, border-color 180ms ease;
}

.download-button {
  padding: 11px 15px;
  white-space: nowrap;
}

.download-button:hover,
.reset-button:hover {
  border-color: rgba(183, 154, 232, 0.65);
  background: rgba(183, 154, 232, 0.15);
}

.filter-bar {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
  align-items: end;
  gap: 12px;
  margin-bottom: 18px;
  padding: 17px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: rgba(18, 17, 27, 0.8);
}

.filter-bar label {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 9px;
}

.filter-bar label > span {
  color: #928ca2;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 9px;
  letter-spacing: 0.1em;
}

.filter-bar select {
  width: 100%;
  min-width: 0;
  padding: 11px 10px;
  border: 1px solid #353044;
  border-radius: 7px;
  color: #d7d1e2;
  background: #100f18;
  font-size: 11px;
}

.reset-button {
  height: 38px;
  padding: 0 13px;
}

.table-wrap {
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: 13px;
  background: rgba(17, 16, 25, 0.84);
}

.case-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  white-space: nowrap;
}

.case-table th {
  padding: 16px 15px;
  border-bottom: 1px solid var(--border);
  color: #817b91;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 8px;
  font-weight: 500;
  letter-spacing: 0.1em;
}

.case-table td {
  padding: 17px 15px;
  border-bottom: 1px solid rgba(183, 166, 222, 0.07);
  color: #bdb8ca;
  font-size: 11px;
}

.case-table tbody tr {
  cursor: pointer;
  transition: background 160ms ease;
}

.case-table tbody tr:hover,
.case-table tbody tr.selected-row {
  background: rgba(183, 154, 232, 0.08);
}

.case-table tbody tr:last-child td {
  border-bottom: 0;
}

.case-table td strong {
  display: block;
  color: #e7e2f0;
  font-weight: 600;
}

.table-subtext {
  display: block;
  margin-top: 5px;
  color: #777184;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 9px;
}

.amount-cell {
  color: #e4d9f8 !important;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
}

.stage-tag {
  display: inline-block;
  padding: 6px 8px;
  border: 1px solid rgba(183, 154, 232, 0.18);
  border-radius: 5px;
  color: #c0a9e8;
  background: rgba(183, 154, 232, 0.06);
  font-size: 9px;
}

.outcome-tag {
  display: inline-flex;
  align-items: center;
  padding: 5px 9px;
  border: 1px solid transparent;
  border-radius: 5px;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 9px;
}

.status-won {
  border-color: rgba(139, 213, 178, 0.2);
  color: var(--success);
  background: rgba(139, 213, 178, 0.07);
}

.status-lost {
  border-color: rgba(231, 141, 156, 0.2);
  color: var(--danger);
  background: rgba(231, 141, 156, 0.07);
}

.status-pending {
  border-color: rgba(232, 194, 127, 0.2);
  color: var(--warning);
  background: rgba(232, 194, 127, 0.07);
}

.row-arrow {
  color: var(--accent) !important;
  font-size: 16px !important;
}

.table-footer {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  padding: 13px 4px;
  color: #706a7e;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 8px;
  letter-spacing: 0.08em;
}

.empty-table {
  padding: 35px !important;
  text-align: center;
}

/* Outcomes */

.outcomes-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  padding: 25px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: linear-gradient(
    110deg,
    rgba(65, 48, 91, 0.2),
    rgba(18, 17, 27, 0.9)
  );
}

.outcomes-strip h2 {
  font-size: 19px;
}

.outcome-summary {
  display: flex;
  gap: 30px;
}

.outcome-summary > div {
  display: grid;
  grid-template-columns: auto auto;
  align-items: center;
  column-gap: 9px;
}

.outcome-summary strong {
  font-size: 20px;
  font-weight: 550;
}

.outcome-summary > div > span:last-child {
  grid-column: 2;
  color: #858093;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 8px;
  letter-spacing: 0.1em;
}

.outcome-dot {
  grid-row: span 2;
  width: 7px;
  height: 7px;
  border-radius: 50%;
}

.won-dot {
  background: var(--success);
}

.lost-dot {
  background: var(--danger);
}

.pending-dot {
  background: var(--warning);
}

/* Footer */

.page-footer {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  padding: 28px 0;
  margin-top: 30px;
  color: #696477;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 8px;
  letter-spacing: 0.1em;
}

/* Slide-over intelligence panel */

.panel-backdrop,
.modal-backdrop {
  position: fixed;
  z-index: 10;
  inset: 0;
  border: 0;
  background: rgba(3, 3, 8, 0.7);
  backdrop-filter: blur(5px);
}

.insight-panel {
  position: fixed;
  z-index: 11;
  top: 0;
  right: 0;
  display: flex;
  width: min(440px, 100%);
  height: 100dvh;
  flex-direction: column;
  overflow-y: auto;
  padding: 34px;
  border-left: 1px solid rgba(183, 154, 232, 0.25);
  background:
    radial-gradient(
      ellipse at 100% 0%,
      rgba(128, 92, 177, 0.18),
      transparent 48%
    ),
    #11101a;
  box-shadow: -25px 0 80px rgba(0, 0, 0, 0.35);
  animation: panel-enter 220ms ease-out;
}

@keyframes panel-enter {
  from {
    opacity: 0;
    transform: translateX(35px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.panel-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.panel-header h2 {
  margin: 12px 0 0;
  font-size: 36px;
  letter-spacing: -0.05em;
}

.panel-close {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  border: 1px solid var(--border);
  border-radius: 50%;
  color: #c9c1d9;
  background: rgba(255, 255, 255, 0.035);
  font-size: 23px;
  transition: background 160ms ease;
}

.panel-close:hover {
  background: rgba(183, 154, 232, 0.14);
}

.panel-status {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 26px;
  color: #aaa3b9;
  font-size: 11px;
}

.panel-amount {
  margin-top: 38px;
  padding: 23px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: rgba(183, 154, 232, 0.055);
}

.panel-amount > span,
.panel-amount > p {
  color: #90899e;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 9px;
  letter-spacing: 0.1em;
}

.panel-amount > strong {
  display: block;
  margin-top: 13px;
  color: #e6d9fa;
  font-size: 34px;
  font-weight: 550;
  letter-spacing: -0.05em;
}

.panel-amount > p {
  margin-bottom: 0;
  letter-spacing: 0;
}

.panel-divider {
  height: 1px;
  margin: 30px 0;
  background: var(--border);
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-top: 12px;
}

.detail-list > div {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  padding: 15px 0;
  border-bottom: 1px solid rgba(183, 166, 222, 0.09);
}

.detail-list span {
  color: #898397;
  font-size: 11px;
}

.detail-list strong {
  max-width: 58%;
  color: #ddd7e8;
  font-size: 11px;
  font-weight: 500;
  text-align: right;
}

.panel-note {
  margin-top: 29px;
  padding: 18px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: rgba(183, 154, 232, 0.045);
}

.panel-note > p:last-child {
  margin-bottom: 0;
  color: #aaa4b8;
  font-size: 11px;
  line-height: 1.9;
}

.panel-note strong {
  color: #ded2f3;
  font-weight: 600;
}

.panel-footnote {
  margin-top: auto;
  padding-top: 35px;
  color: #706a7d;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 8px;
  letter-spacing: 0.1em;
}

/* Project credentials modal */

.modal-backdrop {
  z-index: 20;
  display: grid;
  place-items: center;
  padding: 20px;
}

.metadata-modal {
  width: min(470px, 100%);
  max-height: min(90dvh, 760px);
  overflow-y: auto;
  padding: 31px;
  border: 1px solid rgba(183, 154, 232, 0.27);
  border-radius: 17px;
  background:
    radial-gradient(
      ellipse at 10% 0%,
      rgba(126, 90, 176, 0.19),
      transparent 50%
    ),
    #14121e;
  box-shadow: 0 30px 100px rgba(0, 0, 0, 0.5);
  animation: modal-enter 180ms ease-out;
}

@keyframes modal-enter {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.modal-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30px;
}

.modal-emblem {
  width: 53px;
  height: 53px;
  margin-bottom: 27px;
  border-radius: 15px;
  font-size: 24px;
  font-weight: 600;
}

.metadata-modal h2 {
  margin: 12px 0 28px;
  font-size: 39px;
  font-weight: 550;
  line-height: 1.03;
  letter-spacing: -0.06em;
}

.metadata-details {
  border-top: 1px solid var(--border);
}

.metadata-details > div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 16px 0;
  border-bottom: 1px solid var(--border);
}

.metadata-details span {
  color: #888296;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 8px;
  letter-spacing: 0.1em;
}

.metadata-details strong {
  color: #ded7e9;
  font-size: 11px;
  font-weight: 500;
  text-align: right;
  overflow-wrap: anywhere;
}

.modal-footer {
  margin: 24px 0 0;
  color: #777184;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 8px;
  letter-spacing: 0.1em;
}

/* Loading and error states */

.loading-screen {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 25px;
  color: #e5deef;
  background:
    radial-gradient(
      ellipse at center,
      rgba(109, 79, 153, 0.16),
      transparent 50%
    ),
    #09090f;
}

.loading-screen > p {
  margin: 15px 0 0;
  font-size: 14px;
}

.loading-screen > span {
  color: #888196;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 9px;
  letter-spacing: 0.14em;
}

.loading-orbit {
  width: 34px;
  height: 34px;
  border: 2px solid rgba(183, 154, 232, 0.15);
  border-top-color: var(--accent-bright);
  border-radius: 50%;
  animation: spin 800ms linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.error-card {
  max-width: 450px;
  padding: 32px;
  border: 1px solid rgba(231, 141, 156, 0.25);
  border-radius: 15px;
  background: var(--surface);
}

.error-card h1 {
  margin: 15px 0 10px;
  font-size: 24px;
}

.error-card > p {
  color: #aaa4b8;
  font-size: 13px;
  line-height: 1.8;
}

.primary-button {
  margin-top: 15px;
  padding: 11px 16px;
  border: 1px solid rgba(183, 154, 232, 0.4);
  border-radius: 7px;
  color: var(--accent-bright);
  background: rgba(183, 154, 232, 0.1);
}

/* Tablet */

@media (max-width: 900px) {
  .page-content {
    width: 92%;
  }

  .metrics-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .lifecycle-track {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .distribution-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .filter-bar {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .reset-button {
    min-height: 38px;
  }
}

/* Mobile */

@media (max-width: 600px) {
  .topbar {
    min-height: 70px;
    padding: 0 5%;
  }

  .topbar-right {
    gap: 10px;
  }

  .live-indicator {
    font-size: 0;
  }

  .metadata-label {
    display: none;
  }

  .page-content {
    width: 90%;
  }

  .hero-section {
    align-items: flex-start;
    padding: 65px 0 38px;
  }

  .hero-index {
    display: none;
  }

  .hero-section h1 {
    font-size: clamp(47px, 13vw, 68px);
  }

  .hero-description {
    font-size: 12px;
  }

  .metrics-grid {
    gap: 9px;
  }

  .metric-card {
    padding: 16px 13px;
  }

  .metric-card > strong {
    font-size: 25px;
  }

  .metric-heading {
    font-size: 8px;
  }

  .section-block {
    margin-top: 48px;
  }

  .section-heading {
    align-items: flex-start;
  }

  .section-heading h2 {
    font-size: 21px;
  }

